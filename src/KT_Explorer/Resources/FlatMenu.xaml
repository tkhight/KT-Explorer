<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        メニューのフラットなデザイン(画面全体: メニューバー・ドロップダウン・右クリックのメニュー)。
        規則は、ほかの部品と同じ: 普通=背景なし / ホバー=淡い水色(#E5F3FF) / 開いている=濃い水色(#CCE8FF) / 使えない=薄い灰色。
        開いたメニューは、白い背景・角を 8px 丸め・細い灰色の枠(#D0D0D0)・ごく薄い影。
    -->

    <SolidColorBrush x:Key="KtMenuHover" Color="#FFE5F3FF"/>
    <SolidColorBrush x:Key="KtMenuOpen" Color="#FFCCE8FF"/>
    <SolidColorBrush x:Key="KtMenuText" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="KtMenuDisabled" Color="#FFB3B3B3"/>

    <!-- メニューバー -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="#FFFAFAFA"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FFECECEC" BorderThickness="0,0,0,1" Padding="6,2">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右クリックのメニュー: 開いたメニューと同じ見た目(影のための余白つき) -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource KtMenuText}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="4,2,10,12" Background="#FFFFFFFF" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="8" Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.15"/>
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 区切り線 -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="#FFE8E8E8" Height="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- メニューバーの見出し(サブメニューを持つ) -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelHeaderTemplateKey}" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,3" SnapsToDevicePixels="True">
            <Grid>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3" Focusable="False" AllowsTransparency="True" PopupAnimation="None"
                       IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Margin="4,2,10,12" Background="#FFFFFFFF" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="8" Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.15"/>
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource KtMenuHover}"/></Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource KtMenuOpen}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KtMenuDisabled}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- メニューバーの項目(サブメニューを持たない) -->
    <ControlTemplate x:Key="{x:Static MenuItem.TopLevelItemTemplateKey}" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,3" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource KtMenuHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource KtMenuDisabled}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 開いたメニューの項目(サブメニューなし): [チェック][アイコン][文字][ショートカット] -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" MinHeight="28" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="KtMenuShortcut"/>
                    <ColumnDefinition Width="12"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed" Data="M0,5 L3.5,9 L10,1" Stroke="#FF0B5CAD" StrokeThickness="1.7"
                      HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <ContentPresenter Grid.Column="1" ContentSource="Icon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,0,1"/>
                <TextBlock x:Name="Gesture" Grid.Column="3" Text="{TemplateBinding InputGestureText}" Foreground="#FF888888" FontSize="11"
                           Margin="28,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource KtMenuHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KtMenuDisabled}"/>
                <Setter TargetName="Gesture" Property="Foreground" Value="#FFC8C8C8"/>
                <Setter TargetName="Check" Property="Stroke" Value="#FFB3B3B3"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 開いたメニューの項目(サブメニューあり): 右端に › -->
    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" MinHeight="28" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="KtMenuShortcut"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="Check" Grid.Column="0" Visibility="Collapsed" Data="M0,5 L3.5,9 L10,1" Stroke="#FF0B5CAD" StrokeThickness="1.7"
                      HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <ContentPresenter Grid.Column="1" ContentSource="Icon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="2" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="0,0,0,1"/>
                <TextBlock x:Name="Gesture" Grid.Column="3" Text="{TemplateBinding InputGestureText}" Foreground="#FF888888" FontSize="11"
                           Margin="28,0,0,0" VerticalAlignment="Center"/>
                <Path x:Name="Arrow" Grid.Column="4" Data="M0,0 L4,4 L0,8" Stroke="#FF888888" StrokeThickness="1.3"
                      HorizontalAlignment="Left" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-8" Focusable="False" AllowsTransparency="True" PopupAnimation="None"
                       IsOpen="{Binding Path=IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Margin="4,2,10,12" Background="#FFFFFFFF" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="8" Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.15"/>
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource KtMenuHover}"/></Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource KtMenuHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource KtMenuDisabled}"/>
                <Setter TargetName="Gesture" Property="Foreground" Value="#FFC8C8C8"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="#FFC8C8C8"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- すべてのメニューの項目に、役割(メニューバーの見出し・項目 / サブメニューの項目・見出し)に合った見た目を当てる -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource KtMenuText}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelItemTemplateKey}}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuHeaderTemplateKey}}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.SubmenuItemTemplateKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
