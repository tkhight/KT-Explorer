<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- トレイアイコン(NotifyIcon)のためだけに WinForms を使う -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- アプリのアイコン(exe・エクスプローラーでの表示) -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- 版番号(exe のプロパティに出る。配布用の zip の名前にも使う: tools/release/publish.ps1) -->
    <Version>1.0.0</Version>
    <Product>KT_Explorer</Product>
    <Authors>tkhight</Authors>
    <Copyright>Copyright (c) 2026 tkhight</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF の型(Application, MessageBox, Button など)と名前が衝突するため、暗黙の using から外す -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ウィンドウ・トレイのアイコンとして、実行ファイルの中から読む -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 使い方(「ヘルプ」→「使い方」で開く)。exe の隣に「使い方.html」と images フォルダとして置く -->
    <Content Include="..\..\docs\usage.html" Link="使い方.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\*.png" Link="images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
