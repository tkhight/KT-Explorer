<UserControl x:Class="KT_Explorer.Views.PaneTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KT_Explorer.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
        <!-- 1つのペイン(ヘッダー + 一覧)。操作中のペインは青枠で示す -->
        <DataTemplate x:Key="PaneTemplate">
            <Border Margin="1" BorderThickness="2" PreviewMouseDown="Pane_PreviewMouseDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivePane}" Value="True">
                                <Setter Property="BorderBrush" Value="SteelBlue"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <!-- ヘッダー: 参照元のグループがあるペインは、その色の帯と、グループ名の名札 -->
                    <DockPanel DockPanel.Dock="Top" Background="{Binding PaneBarBrush}">
                        <Button DockPanel.Dock="Right" Content="✕" Padding="5,0" BorderThickness="0" Background="Transparent"
                                ToolTip="このペインを閉じる" Click="ClosePane_Click"/>
                        <Border DockPanel.Dock="Left" Margin="4,2,0,2" Padding="6,0" CornerRadius="3" VerticalAlignment="Center"
                                Background="{Binding SourceTagBrush}" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisible}}"
                                ToolTip="このペインの参照元のグループ">
                            <TextBlock Text="{Binding SourceName}" Foreground="{Binding SourceTagTextBrush}" FontWeight="SemiBold" FontSize="11"
                                       MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock Text="{Binding Path}" Margin="6,3" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <views:FolderView/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ペインと、その間のスプリッターは、ペインの増減に合わせてコードで組み立てる -->
    <Grid x:Name="Host"/>
</UserControl>
