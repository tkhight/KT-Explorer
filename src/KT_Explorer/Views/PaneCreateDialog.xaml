<Window
        Icon="/Resources/app.ico" x:Class="KT_Explorer.Views.PaneCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MaxHeight="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- 既存タブから選択: チェックを付けた 2 つか 3 つのタブのフォルダで、ペインを作る -->
        <ListBox x:Name="TabList" MaxHeight="300" Visibility="Collapsed" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2,1"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- 文字列をそのまま Content にすると、名前の「_」がアクセスキー扱いで消えるため、TextBlock に入れる -->
                    <!-- 行の背景はグループの色。グループ名は色の名札で示す -->
                    <Border Background="{Binding RowBrush}" CornerRadius="4" Padding="6,3">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" AutomationProperties.Name="{Binding Label}"
                                  ToolTip="{Binding Path}" VerticalContentAlignment="Center" Checked="Choice_Changed" Unchecked="Choice_Changed">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="{Binding TagBrush}" CornerRadius="3" Padding="6,0" Margin="2,0,8,0" MinWidth="44">
                                    <TextBlock Text="{Binding GroupName}" Foreground="{Binding TagTextBrush}" FontWeight="SemiBold" FontSize="11"
                                               HorizontalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </CheckBox>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- フォルダを指定: 2 つか 3 つ -->
        <StackPanel x:Name="FolderRows" Visibility="Collapsed"/>

        <TextBlock x:Name="CountText" Margin="0,8,0,0" Foreground="#FF555555"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CreateButton" Content="作成" Width="80" IsDefault="True" IsEnabled="False" Click="Create_Click"/>
            <Button Content="キャンセル" Width="80" Margin="6,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
