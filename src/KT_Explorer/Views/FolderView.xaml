<UserControl x:Class="KT_Explorer.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseDown="OnActivate" GotKeyboardFocus="OnActivate">
    <UserControl.Resources>
        <!-- アイコン・一覧の表示で使う、名前の通常表示と、直接編集の入力欄(詳細の名前の列と同じ動き。Tag="NameText" は、ゆっくり2回クリックでの名前の変更の目印) -->
        <Style x:Key="NameTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditBoxStyle" TargetType="TextBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- アイコン: 大きなアイコン(画像・動画などはサムネイル)の下に、名前 -->
        <DataTemplate x:Key="IconItemTemplate">
            <StackPanel Width="108" Margin="2" ToolTip="{Binding Name}">
                <Image Source="{Binding Thumbnail}" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" Tag="NameText" Style="{StaticResource NameTextStyle}" Margin="0,2,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditBoxStyle}"
                         Margin="0,2,0,0" Padding="1,0" TextAlignment="Center"
                         IsVisibleChanged="EditBox_IsVisibleChanged" KeyDown="EditBox_KeyDown"
                         PreviewTextInput="EditBox_PreviewTextInput" LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
            </StackPanel>
        </DataTemplate>

        <!-- 一覧: 小さなアイコンと名前 -->
        <DataTemplate x:Key="ListItemTemplate">
            <StackPanel Orientation="Horizontal" Width="220" ToolTip="{Binding Name}">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" Tag="NameText" Style="{StaticResource NameTextStyle}"
                           TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditBoxStyle}"
                         MinWidth="150" Padding="1,0"
                         IsVisibleChanged="EditBox_IsVisibleChanged" KeyDown="EditBox_KeyDown"
                         PreviewTextInput="EditBox_PreviewTextInput" LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
            </StackPanel>
        </DataTemplate>

        <!-- 並べ方: アイコン=表示幅で折り返して、上から下へ。一覧=表示の高さで折り返して、左から右へ(列) -->
        <ItemsPanelTemplate x:Key="IconsPanel">
            <WrapPanel Orientation="Horizontal"
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <WrapPanel Orientation="Vertical"
                       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文字を打つと、その文字で始まる名前の項目へ移動する(TextSearch。続けて打つと絞られ、少し間を置くとリセット) -->
        <ListView x:Name="FileList" ItemsSource="{Binding Items}" SelectionMode="Extended" AllowDrop="True"
                  IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                  MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown"
                  PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                  PreviewMouseMove="FileList_PreviewMouseMove"
                  PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                  ContextMenuOpening="FileList_ContextMenuOpening"
                  PreviewKeyDown="FileList_PreviewKeyDown"
                  GridViewColumnHeader.Click="ColumnHeader_Click"
                  SelectionChanged="FileList_SelectionChanged"
                  DragOver="FileList_DragOver" Drop="FileList_Drop">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名前" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <!-- 通常表示(ゆっくり2回クリックで名前の変更を始める対象なので Tag で見分ける) -->
                                    <TextBlock Text="{Binding Name}" Tag="NameText">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 名前の直接編集(エクスプローラーと同じ: 拡張子を除いて選択、Enter で確定、Esc で取り消し) -->
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Padding="1,0"
                                             IsVisibleChanged="EditBox_IsVisibleChanged" KeyDown="EditBox_KeyDown"
                                             PreviewTextInput="EditBox_PreviewTextInput" LostKeyboardFocus="EditBox_LostKeyboardFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="更新日時" Width="130" DisplayMemberBinding="{Binding ModifiedText}"/>
                    <GridViewColumn Header="種類" Width="120" DisplayMemberBinding="{Binding TypeText}"/>
                    <GridViewColumn Header="サイズ" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Margin="6,2" Foreground="DimGray" Text="{Binding Status}"/>
            <TextBlock Margin="6,2" Foreground="DimGray" Text="{Binding FilterNote}"/>
            <TextBlock Margin="6,2" Foreground="DarkOrange" Text="{Binding FilterProblem}"/>
            <TextBlock Margin="6,2" Foreground="Firebrick" Text="{Binding Error}"/>
        </StackPanel>
    </Grid>
</UserControl>
