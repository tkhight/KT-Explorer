<UserControl x:Class="KT_Explorer.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KT_Explorer.Views"
             PreviewMouseDown="OnActivate" GotKeyboardFocus="OnActivate">
    <UserControl.Resources>
        <!-- アイコン・一覧の表示で使う、名前の通常表示と、直接編集の入力欄(詳細の名前の列と同じ動き。Tag="NameText" は、ゆっくり2回クリックでの名前の変更の目印) -->
        <Style x:Key="NameTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditBoxStyle" TargetType="TextBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <local:FirstBrushConverter x:Key="FirstBrush"/>

        <!-- 一覧の列見出し: 立体的なボタンをやめ、フラットに(下に細い線)。ホバーで淡い水色。列幅の変更(右端のつまみ)は、そのまま使える -->
        <Style x:Key="KtColumnHeader" TargetType="GridViewColumnHeader">
            <!-- 表示中のグループに色があれば、一覧の背景より少し濃い色。無ければ透明(一覧の背景が見える) -->
            <!-- ペインは、参照元のグループの色を優先する -->
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource FirstBrush}" FallbackValue="Transparent">
                        <Binding Path="DataContext.SourceViewHeaderBackground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="DataContext.ViewHeaderBackground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#FFE3E3E3" BorderThickness="0,0,0,1">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE" Background="Transparent">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFE5F3FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFCCE8FF"/></Trigger>
                            <Trigger Property="Role" Value="Padding"><Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- アイコン: 大きなアイコン(画像・動画などはサムネイル)の下に、名前 -->
        <DataTemplate x:Key="IconItemTemplate">
            <StackPanel Width="{DynamicResource IconItemWidth}" Margin="2" ToolTip="{Binding Name}">
                <!-- 大きなアイコンに、オーバーレイ(OneDrive・SVN などの状態)を重ねる -->
                <Grid Width="{DynamicResource IconImageSize}" Height="{DynamicResource IconImageSize}" HorizontalAlignment="Center">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="{Binding OverlayIconLarge}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock Text="{Binding Name}" Tag="NameText" Style="{StaticResource NameTextStyle}" Margin="0,2,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditBoxStyle}"
                         Margin="0,2,0,0" Padding="1,0" TextAlignment="Center"
                         IsVisibleChanged="EditBox_IsVisibleChanged" KeyDown="EditBox_KeyDown"
                         PreviewTextInput="EditBox_PreviewTextInput" LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
            </StackPanel>
        </DataTemplate>

        <!-- 一覧: 小さなアイコンと名前 -->
        <DataTemplate x:Key="ListItemTemplate">
            <StackPanel Orientation="Horizontal" Width="220" ToolTip="{Binding Name}">
                <Grid Width="16" Height="16" Margin="0,0,6,0">
                    <Image Source="{Binding Icon}"/>
                    <Image Source="{Binding OverlayIcon}" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock Text="{Binding Name}" Tag="NameText" Style="{StaticResource NameTextStyle}"
                           TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditBoxStyle}"
                         MinWidth="150" Padding="1,0"
                         IsVisibleChanged="EditBox_IsVisibleChanged" KeyDown="EditBox_KeyDown"
                         PreviewTextInput="EditBox_PreviewTextInput" LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
            </StackPanel>
        </DataTemplate>

        <!-- 並べ方: アイコン=表示幅で折り返して、上から下へ。一覧=表示の高さで折り返して、左から右へ(列) -->
        <ItemsPanelTemplate x:Key="IconsPanel">
            <WrapPanel Orientation="Horizontal"
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <WrapPanel Orientation="Vertical"
                       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文字を打つと、その文字で始まる名前の項目へ移動する(TextSearch。続けて打つと絞られ、少し間を置くとリセット) -->
        <!-- 背景は、表示中のグループ(ペインは参照元のグループ)の色を、ごく薄くしたもの。色が無ければ白 -->
        <ListView x:Name="FileList" ItemsSource="{Binding Items}" SelectionMode="Extended" AllowDrop="True"
                  IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                  MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown"
                  PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                  PreviewMouseMove="FileList_PreviewMouseMove"
                  PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                  ContextMenuOpening="FileList_ContextMenuOpening"
                  PreviewKeyDown="FileList_PreviewKeyDown" PreviewMouseWheel="FileList_PreviewMouseWheel" PreviewMouseRightButtonUp="FileList_PreviewMouseRightButtonUp"
                  GridViewColumnHeader.Click="ColumnHeader_Click"
                  SelectionChanged="FileList_SelectionChanged"
                  DragOver="FileList_DragOver" Drop="FileList_Drop">
            <ListView.Background>
                <MultiBinding Converter="{StaticResource FirstBrush}" FallbackValue="White">
                    <Binding Path="DataContext.SourceViewBackground" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    <Binding Path="DataContext.ViewBackground" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </MultiBinding>
            </ListView.Background>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource KtColumnHeader}">
                    <GridViewColumn Header="名前" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="16" Height="16" Margin="0,0,6,0">
                                        <Image Source="{Binding Icon}"/>
                                        <Image Source="{Binding OverlayIcon}" IsHitTestVisible="False"/>
                                    </Grid>
                                    <!-- 通常表示(ゆっくり2回クリックで名前の変更を始める対象なので Tag で見分ける) -->
                                    <TextBlock Text="{Binding Name}" Tag="NameText">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 名前の直接編集(エクスプローラーと同じ: 拡張子を除いて選択、Enter で確定、Esc で取り消し) -->
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" Padding="1,0"
                                             IsVisibleChanged="EditBox_IsVisibleChanged" KeyDown="EditBox_KeyDown"
                                             PreviewTextInput="EditBox_PreviewTextInput" LostKeyboardFocus="EditBox_LostKeyboardFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="更新日時" Width="130" DisplayMemberBinding="{Binding ModifiedText}"/>
                    <GridViewColumn Header="種類" Width="120" DisplayMemberBinding="{Binding TypeText}"/>
                    <GridViewColumn Header="サイズ" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Margin="6,2" Foreground="DimGray" Text="{Binding Status}"/>
            <TextBlock Margin="6,2" Foreground="DimGray" Text="{Binding FilterNote}"/>
            <TextBlock Margin="6,2" Foreground="DarkOrange" Text="{Binding FilterProblem}"/>
            <TextBlock Margin="6,2" Foreground="Firebrick" Text="{Binding Error}"/>
        </StackPanel>
    </Grid>
</UserControl>
