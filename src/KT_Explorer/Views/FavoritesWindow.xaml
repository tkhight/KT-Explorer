<Window
        Icon="/Resources/app.ico" x:Class="KT_Explorer.Views.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="お気に入りの整理" Width="680" Height="500" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Foreground="DimGray" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="項目を選んで、右のボタンで、並べ替え・グループへの移動・編集・削除ができます。グループは、メニューではサブメニューになります。「OK」で反映します。"/>

        <TreeView x:Name="Tree" Grid.Row="1" AutomationProperties.AutomationId="FavoritesTree"
                  SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayText}" Padding="2,2"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Width="160">
            <Button x:Name="UpButton" Content="上へ" Margin="0,0,0,4" Padding="0,4" Click="Up_Click"/>
            <Button x:Name="DownButton" Content="下へ" Margin="0,0,0,4" Padding="0,4" Click="Down_Click"/>
            <Button x:Name="MoveButton" Content="グループへ移動 ▾" Margin="0,0,0,12" Padding="0,4" Click="Move_Click"/>
            <Button x:Name="EditButton" Content="編集…" Margin="0,0,0,4" Padding="0,4" Click="Edit_Click"/>
            <Button x:Name="DeleteButton" Content="削除" Margin="0,0,0,12" Padding="0,4" Click="Delete_Click"/>
            <Button x:Name="SeparatorButton" Content="区切り線を追加" Margin="0,0,0,4" Padding="0,4" Click="AddSeparator_Click"
                    ToolTip="選んだ項目の下に、区切り線を入れます(何も選んでいなければ、末尾)"/>
            <Button x:Name="GroupButton" Content="グループを追加…" Padding="0,4" Click="AddGroup_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="84" Padding="0,4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="キャンセル" Width="84" Padding="0,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
