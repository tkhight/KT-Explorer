<Window
        Icon="/Resources/app.ico" x:Class="KT_Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KT_Explorer.ViewModels"
        xmlns:views="clr-namespace:KT_Explorer.Views"
        xmlns:svc="clr-namespace:KT_Explorer.Services"
        Title="KT_Explorer" Height="700" Width="1100"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding UpCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding TogglePreviewCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl+Shift" Command="{Binding SetViewModeCommand}" CommandParameter="Details"/>
        <KeyBinding Key="D2" Modifiers="Ctrl+Shift" Command="{Binding SetViewModeCommand}" CommandParameter="Icons"/>
        <KeyBinding Key="D3" Modifiers="Ctrl+Shift" Command="{Binding SetViewModeCommand}" CommandParameter="List"/>
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding ReopenClosedTabCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- メニューバー -->
        <DockPanel Grid.Row="0">
        <!-- メニューバーの右端: ペイン(2・3・指定) -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,1,4,1">
            <Button Content="▥2" Width="34" ToolTip="2ペイン(現在のフォルダを右に追加)" Command="{Binding OpenPanesCommand}" CommandParameter="2"/>
            <Button Content="▥3" Width="34" Margin="2,0,0,0" ToolTip="3ペイン(現在のフォルダを右に追加)" Command="{Binding OpenPanesCommand}" CommandParameter="3"/>
            <Button Content="指定ペイン ▾" Margin="2,0,0,0" Padding="6,0" ToolTip="2つか3つのタブ・フォルダを選んで、ペインを作成" Click="SpecifyPane_Click"/>
        </StackPanel>
        <Menu x:Name="MainMenu">
            <MenuItem Header="ファイル(_F)" SubmenuOpened="FileMenu_SubmenuOpened">
                <MenuItem x:Name="MenuOpenTerminal" Header="ターミナルで開く(_T)" Click="MenuOpenTerminal_Click"/>
                <MenuItem x:Name="MenuWinMerge" Header="WinMerge(_M)" Click="MenuWinMerge_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuNew" Header="新規作成(_N)">
                    <MenuItem Header="フォルダー(_F)" Click="MenuNewFolder_Click"/>
                    <MenuItem Header="テキスト ドキュメント(_T)" Click="MenuNewTextFile_Click"/>
                </MenuItem>
                <MenuItem x:Name="MenuProperties" Header="プロパティ(_R)" Click="MenuProperties_Click"/>
                <Separator/>
                <MenuItem Header="アプリケーションの終了(_X)" Click="MenuExit_Click"/>
            </MenuItem>
            <!-- 以下の項目は、順に作っていく(いまは、見出しだけ) -->
            <MenuItem x:Name="MenuEdit" Header="編集(_E)" SubmenuOpened="EditMenu_SubmenuOpened">
                <MenuItem x:Name="MenuUndo" Header="元に戻す(_U)" InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                <MenuItem x:Name="MenuRedo" Header="やり直し(_R)" InputGestureText="Ctrl+Y" Click="MenuRedo_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuCut" Header="切り取り(_T)" InputGestureText="Ctrl+X" Click="MenuCut_Click"/>
                <MenuItem x:Name="MenuCopy" Header="コピー(_C)" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                <MenuItem x:Name="MenuPaste" Header="貼り付け(_P)" InputGestureText="Ctrl+V" Click="MenuPaste_Click"/>
                <MenuItem x:Name="MenuDelete" Header="削除(_D)" InputGestureText="Delete" Click="MenuDelete_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSelectAll" Header="全て選択(_A)" InputGestureText="Ctrl+A" Click="MenuSelectAll_Click"/>
            </MenuItem>
            <!-- 表示・お気に入り・履歴は、開くたびに中身を作る(最初の項目は、開くための仮のもの) -->
            <MenuItem x:Name="MenuView" Header="表示(_V)" SubmenuOpened="ViewMenu_SubmenuOpened"><MenuItem Header="…"/></MenuItem>
            <MenuItem x:Name="MenuFavorites" Header="お気に入り(_A)" SubmenuOpened="FavoritesMenu_SubmenuOpened"><MenuItem Header="…"/></MenuItem>
            <MenuItem x:Name="MenuHistory" Header="履歴(_R)" SubmenuOpened="HistoryMenu_SubmenuOpened"><MenuItem Header="…"/></MenuItem>
            <MenuItem x:Name="MenuTools" Header="ツール(_T)" SubmenuOpened="ToolsMenu_SubmenuOpened"><MenuItem Header="…"/></MenuItem>
            <MenuItem x:Name="MenuHelp" Header="ヘルプ(_H)"/>
        </Menu>
        </DockPanel>

        <!-- ツールバー -->
        <DockPanel Grid.Row="1" Margin="4" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="←" Width="30" ToolTip="戻る (Alt+←)"
                    Command="{Binding BackCommand}" IsEnabled="{Binding CurrentFolder.CanGoBack}"/>
            <Button DockPanel.Dock="Left" Content="→" Width="30" Margin="2,0,0,0" ToolTip="進む (Alt+→)"
                    Command="{Binding ForwardCommand}" IsEnabled="{Binding CurrentFolder.CanGoForward}"/>
            <Button DockPanel.Dock="Left" Content="↑" Width="30" Margin="2,0,0,0" ToolTip="一つ上の階層へ (Alt+↑)"
                    Command="{Binding UpCommand}" IsEnabled="{Binding CurrentFolder.CanGoUp}"/>
            <Button DockPanel.Dock="Left" Content="⟳" Width="30" Margin="2,0,0,0" ToolTip="更新 (F5)"
                    Command="{Binding RefreshCommand}"/>
            <Button DockPanel.Dock="Left" Content="↶" Width="30" Margin="6,0,0,0" ToolTip="{Binding UndoToolTip}"
                    IsEnabled="{Binding CanUndo}" Click="Undo_Click"/>
            <Button DockPanel.Dock="Left" Content="↷" Width="30" Margin="2,0,6,0" ToolTip="{Binding RedoToolTip}"
                    IsEnabled="{Binding CanRedo}" Click="Redo_Click"/>
            <ToggleButton DockPanel.Dock="Right" Content="プレビュー" Margin="2,0,0,0" Padding="6,0" IsChecked="{Binding ShowPreview}"
                          ToolTip="選択したファイルの内容を、右側に表示します (Alt+P)"/>
            <TextBox DockPanel.Dock="Right" x:Name="SearchBox" Width="150" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     ToolTip="このフォルダ以下を検索(Enter で実行 / Esc で解除)&#10;名前: 文字を含むもの / *.png(ワイルドカード)&#10;絞込と同じ条件: type:画像 ext:png size:&gt;10MB date:今週 -除外&#10;ファイルの中身: content:語(または 中身:語)"
                     Text="{Binding CurrentFolder.SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"/>
            <TextBlock DockPanel.Dock="Right" Text="検索:" Margin="10,0,2,0" VerticalAlignment="Center"/>
            <TextBox DockPanel.Dock="Right" x:Name="FilterBox" Width="120" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     ToolTip="表示中の一覧を絞り込み (Ctrl+F / 解除は Esc)&#10;&#10;名前: 文字を含むもの / *.png(ワイルドカード)/ &quot;二語 以上&quot;(引用符)&#10;-draft: 含まないもの(-type:画像 のように条件にも付けられます)&#10;type:画像 動画 音声 文書 圧縮 コード フォルダー ファイル&#10;ext:png,jpg(拡張子)&#10;size:&gt;10MB / size:&lt;=500KB / size:1MB..10MB&#10;date:今日 昨日 今週 今月 今年 / 7d(7日以内)/ &gt;2024-01-01 / 2024-01-01..2024-03-31&#10;空白で区切った条件は、すべて満たすものだけを残します"
                     Text="{Binding CurrentFolder.FilterText, UpdateSourceTrigger=PropertyChanged}" KeyDown="FilterBox_KeyDown"/>
            <TextBlock DockPanel.Dock="Right" Text="絞込:" Margin="10,0,2,0" VerticalAlignment="Center"/>
            <Grid>
                <TextBox x:Name="PathBox" VerticalContentAlignment="Center"
                         Text="{Binding CurrentFolder.Path, Mode=OneWay}" PreviewKeyDown="PathBox_PreviewKeyDown" KeyDown="PathBox_KeyDown"
                         ContextMenuOpening="PathBox_ContextMenuOpening"
                         TextChanged="PathBox_TextChanged" LostKeyboardFocus="PathBox_FocusChanged" GotKeyboardFocus="PathBox_FocusChanged">
                    <!-- 空のメニューを持たせておく(TextBox は、メニューが無いと、自分の標準メニューを先に開いてしまう)。中身は開くたびに組み立てる -->
                    <TextBox.ContextMenu><ContextMenu/></TextBox.ContextMenu>
                </TextBox>
                <!-- パンくず: パス欄に入力していない間、パス欄の上に重ねて表示する。各階層をクリックで移動、▸ でその中のフォルダ -->
                <Border x:Name="Breadcrumb" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"
                        MouseLeftButtonDown="Breadcrumb_MouseLeftButtonDown" ContextMenuOpening="Breadcrumb_ContextMenuOpening"
                        ToolTip="空いているところをクリックすると、パスを入力できます (Ctrl+L)&#10;右クリックで、パスをコピーできます">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>
                <!-- パスの入力補完 -->
                <Popup x:Name="PathSuggestPopup" PlacementTarget="{Binding ElementName=PathBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="False"
                       Focusable="False">
                    <ListBox x:Name="PathSuggestList" MaxHeight="260" MinWidth="320" Focusable="False" PreviewMouseLeftButtonUp="PathSuggestList_Click"/>
                </Popup>
            </Grid>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="120"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- タブグループ(全幅の行。タブをここへドロップして移動できる) -->
            <DockPanel Grid.Row="0" Grid.ColumnSpan="5" Background="#FFE8EEF5">
                <Button DockPanel.Dock="Right" Content="＋グループ" Padding="8,0" ToolTip="タブグループを追加"
                        Click="AddGroup_Click"/>
                <ListBox x:Name="GroupBar" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         PreviewMouseWheel="GroupBar_PreviewMouseWheel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Padding="6,1" FontWeight="SemiBold" AllowDrop="True"
                                       ToolTip="タブをドロップするとこのグループへ移動"
                                       DragOver="Group_DragOver" Drop="Group_Drop">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="名前を変更" Click="RenameGroup_Click"/>
                                        <MenuItem Header="グループを削除" Click="DeleteGroup_Click"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 左端: ツリー(グループタブの行の下) -->
            <Grid Grid.Row="1" Grid.Column="0">
            <!-- 見えているノードだけを作る(仮想化)。フォルダが数千あっても、画面と操作が重くならない。Standard: 使い回さない(IsExpanded・IsSelected の双方向バインドが、使い回しで混ざるのを避ける) -->
            <TreeView x:Name="FolderTree" ItemsSource="{Binding TreeRoots}"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Standard"
                      ScrollViewer.CanContentScroll="True"
                      PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                      ContextMenuOpening="FolderTree_ContextMenuOpening"
                      KeyDown="FolderTree_KeyDown">
                <TreeView.Resources>
                    <!-- 展開/折りたたみの矢印(閉じているときは白抜きの▷、開いているときは黒塗りの◢) -->
                    <Style x:Key="KtTreeExpanderToggle" TargetType="ToggleButton">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Width" Value="16"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Width="16" Height="16">
                                        <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Fill="White" Stroke="#FF989898" Data="M 0,0 L 0,8 L 5,4 Z"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Data" Value="M 6,0 L 6,6 L 0,6 Z"/>
                                            <Setter TargetName="Arrow" Property="Fill" Value="#FF262626"/>
                                            <Setter TargetName="Arrow" Property="Stroke" Value="#FF262626"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Stroke" Value="#FF1BBBFA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Standard"/>
                        <!-- 強調表示とクリックの範囲を、名前の文字の幅だけでなく、行の右端まで広げる(Background が無いとクリックを受けない) -->
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MinWidth="19" Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <ToggleButton x:Name="Expander" Style="{StaticResource KtTreeExpanderToggle}" ClickMode="Press"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <!-- 行の右端まで広がる(列が * なので) -->
                                        <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Left"/>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                        </Trigger>
                                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFE5F3FF"/>
                                        </Trigger>
                                        <!-- 選択中: 操作中(フォーカスあり)は水色、フォーカスが無いときは灰色 -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFDADADA"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#FFCCE8FF"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF99D1FF"/>
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <!-- ファイルをフォルダへドロップして移動/コピー -->
                        <Setter Property="AllowDrop" Value="True"/>
                        <EventSetter Event="DragOver" Handler="TreeItem_DragOver"/>
                        <EventSetter Event="Drop" Handler="TreeItem_Drop"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                        <!-- フォルダのアイコン(OneDrive・SVN などのオーバーレイつき) -->
                        <Grid Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}"/>
                            <Image Source="{Binding OverlayIcon}" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 名前の直接編集(エクスプローラーと同じ: 全選択、Enter で確定、Esc で取り消し) -->
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="120" Padding="1,0"
                                     Loaded="TreeEditBox_Loaded" IsVisibleChanged="TreeEditBox_IsVisibleChanged" KeyDown="TreeEditBox_KeyDown"
                                     PreviewTextInput="TreeEditBox_PreviewTextInput" LostKeyboardFocus="TreeEditBox_LostKeyboardFocus">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            </Grid>

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- 右側: フォルダタブのバー + 内容 -->
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- タブバー(ホイールでタブ切替) -->
                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Content="＋" Width="28" ToolTip="新しいタブ (Ctrl+T)"
                            Command="{Binding NewTabCommand}"/>
                    <ListBox x:Name="TabBar" ItemsSource="{Binding SelectedGroup.Tabs}" SelectedItem="{Binding SelectedTab}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             SelectionChanged="TabBar_SelectionChanged"
                             PreviewMouseDown="TabBar_PreviewMouseDown"
                             PreviewMouseMove="TabBar_PreviewMouseMove"
                             PreviewMouseWheel="TabBar_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 色: 下に太い線 + 薄い背景。ピン留め: 先頭に 📌 -->
                                <Border ToolTip="{Binding ToolTipText}" AllowDrop="True" Padding="4,1"
                                        BorderThickness="0,0,0,3" BorderBrush="{Binding TabColorBrush}" Background="{Binding TabTintBrush}"
                                        ContextMenuOpening="TabItem_ContextMenuOpening"
                                        DragOver="TabItem_DragOver" Drop="TabItem_Drop">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌" FontSize="10" Margin="0,0,2,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Grid Width="16" Height="16" Margin="0,0,2,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}"/>
                                            <Image Source="{Binding OverlayIcon}" IsHitTestVisible="False"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                                   Margin="2,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 内容: 通常タブ=1つの一覧 / ペインタブ=複数ペイン -->
                <ContentControl Grid.Row="1" Content="{Binding SelectedTab}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:FolderTabViewModel}">
                            <views:FolderView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PaneTabViewModel}">
                            <views:PaneTabView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>

            <!-- プレビューウィンドウ(選択したファイルの内容。Alt+P / 設定で表示・非表示) -->
            <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Visibility="Collapsed"
                          DragCompleted="PreviewSplitter_DragCompleted"/>
            <Border x:Name="PreviewPanel" Grid.Row="1" Grid.Column="4" Visibility="Collapsed" DataContext="{Binding Preview}"
                    Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold" Margin="8,6,8,2"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- 説明: 画像・テキストのときは下に、それ以外(情報だけ)のときは上に出す -->
                    <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Margin="8,4" Foreground="#FF555555">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="DockPanel.Dock" Value="Top"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:PreviewKind.Image}">
                                        <Setter Property="DockPanel.Dock" Value="Bottom"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:PreviewKind.Text}">
                                        <Setter Property="DockPanel.Dock" Value="Bottom"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:PreviewKind.Image}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="8,4"
                                 FontFamily="Consolas, MS Gothic" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:PreviewKind.Text}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
